# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Or use Gemini (wins over Anthropic when set): GEMINI_API_KEY=  (optional GEMINI_MODEL=gemini-3.5-flash-lite,...)
GEMINI_API_KEY=
# "auto" = Anthropic if key present, else built-in offline mock agent. Force with "anthropic" or "mock".
LLM_PROVIDER=auto

# --- App ---
PORT=3270
DEFAULT_OFFICE=beirut-homes
DASHBOARD_PIN=1234
SESSION_SECRET=change-me-long-random-string
CORS_ORIGINS=
DEMO_MODE=true
DB_PATH=./data/app.db

# --- WhatsApp Cloud API (optional) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
